# Copy this file to .env and fill in values. Never commit .env.

# LangSmith — set these to trace every MCP tool call in smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=sql-compiler

# Connections config file path (default: config/connections.json)
CONNECTIONS_CONFIG=config/connections.json

# Metadata file path (default: config/database_metadata.json)
METADATA_CONFIG=config/database_metadata.json

# SQL execution limits
QUERY_TIMEOUT_SECONDS=30
QUERY_ROW_LIMIT=1000
QUERY_RETRY_LIMIT=3

# Hyper extract output directory
HYPER_OUTPUT_DIR=outputs/hyper

# SQLite app store (flows, checkpoints, runs) — default: data/app.db
APP_DB_PATH=data/app.db

# FastAPI REST server port (for frontend connection)
API_PORT=8000
